GITHUB_REPO=open-design
GITHUB_ORG=nexu-io
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=78901234
GITHUB_APP_PRIVATE_KEY_BASE64=base64_encoded_pem_private_key
GITHUB_REQUEST_CONCURRENCY=8

# /api/analysis — 由外部 agent（mini 上的 bot）每天 9:00 POST 最新一份分析。
# Vercel KV 集成会自动注入 KV_REST_API_URL / KV_REST_API_TOKEN；本地无 KV 时落到 in-memory 单进程缓存。
KV_REST_API_URL=
KV_REST_API_TOKEN=
# POST /api/analysis 需要 Bearer token 鉴权。留空则该接口返回 503。
ANALYSIS_WRITE_TOKEN=
